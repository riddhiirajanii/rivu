
{
  "version": 2,
  "installCommand": "npm install --omit=dev",
  "functions": {
    "api/[...route].js": {
      "maxDuration": 30
    },
  "api/items/[id].js": {
    "maxDuration": 30
  }, "api/realtime/send.js": {
  "maxDuration": 30
},
"api/realtime/read.js": {
  "maxDuration": 30
},"api/push/public-key.js": {
  "maxDuration": 30
},
"api/push/subscribe.js": {
  "maxDuration": 30
},
"api/push/unsubscribe.js": {
  "maxDuration": 30
}
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "outputDirectory": "public"
}
